 "alGuardar": [
  {
   "si": "!(( \r\n (  (ref_codnac == 'ESP') \r\n && (ref_dec.length == 20 || ref_dec == null) \r\n && (ref_local == null || ['1','2'].includes(ref_local))\r\n )\r\n || \r\n (ref_local == null || ['3','4'].includes(ref_local))\r\n || (ref_codnac != 'ESP')))",
   "msg": "Si la jurisdicción es España la referencia cadastral es vacia o tiene longitud 20 y el territorio es común o foral.",
   "tipo": "error",
   "fuente": "meta"
  },
  {
   "si": "!((((ref_fecfin == null)) || ((ref_fecfin == null || ref_fecini == null) || (ref_fecfin.getTime() > ref_fecini.getTime()))))",
   "msg": "La fecha fin debe ser nula o mayor que la fecha inicio.",
   "tipo": "error",
   "fuente": "meta"
  },
  {
   "si": "!((((((ref_codinm == null || ref_codinm.length === 0)) && ((ref_codele == null || ref_codele.length === 0))) && ((ref_codcom == null || ref_codcom.length === 0))) || (((!(ref_codinm == null || ref_codinm.length === 0)) && (!(ref_codele == null || ref_codele.length === 0))) && (!(ref_codcom == null || ref_codcom.length === 0)))))",
   "msg": "Bien, elemento y componente vinculados se informan conjuntamente o no se informan.",
   "tipo": "error",
   "fuente": "meta"
  }
 ],
