   "alCambiar": {
    "canpre": "udmcom == udmpre ? canfac : canpre"
   },
   "reglas": [
    {
     "si": "canfac == 0 || canpre == 0",
     "msg": "Las siguientes restricciones de verificación fallaron:\nLa cantidad facturada, así como la cantidad precio, debe ser diferente a 0.",
     "tipo": "error",
     "campo": "canfac",
     "fuente": "demo"
    }
   ]
  },
  "udmcom": {
   "req": 1,
   "ro": "gcomfacd.tabori == 'TC' && document_parent.docori != null",
