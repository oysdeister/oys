     "codigo",
     "nomart"
    ],
    "desc": "nomart",
    "noExiste": "Error en la validación"
   },
   "alCambiar": {
    "varlog": "'0'",
    "numlot": "'0'",
    "udmcom": "busca('garticul','codigo',codart,'udmcom') || busca('garticul','codigo',codart,'udmbas')",
    "udmpre": "busca('garticul','codigo',codart,'udmpre') || busca('garticul','codigo',codart,'udmbas')",
    "canfac": "0",
    "canpre": "0"
   }
  },
  "varlog": {
   "req": 1,
   "ro": "(gcomfacd.tabori == 'TC' && document_parent.docori != null) || (linori != null &&  context.isOnUpdate())",
