    "obj": "gart_unidefs",
    "clave": "coduni",
    "cols": [
     "coduni",
     "nomuni"
    ],
    "desc": "nomuni"
   }
  },
  "canpre": {
   "req": 1,
   "ro": "linori != null && gcomfacd.tabori == 'TC' && context.isOnUpdate()",
   "reglas": [
    {
     "si": "udmcom == udmpre && canfac != null && canpre != null && canfac != canpre",
     "msg": "Las siguientes restricciones de verificación fallaron:\nLa cantidad de precios debe coincidir con la cantidad de compra si la unidad de precios coincide con la de compras.",
     "tipo": "error",
     "campo": "canpre",
     "fuente": "meta"
    }
   ]
  },
  "precio": {
   "ro": "virtual_auth.precio_mod == 0  || (gcomfacd.tabori == 'TC' && document_parent.docori != null) || preiva != null"
