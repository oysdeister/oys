 "campos": {
  "sistem": {
   "def": "A",
   "mayus": 1,
   "reglas": [
    {
     "si": "!vacio(sistem) && !/^([A-Z0-9]+)([A-Z0-9._&\\-\\s\\/])*$/.test(sistem)",
     "msg": "El texto contiene caracteres no admitidos",
     "tipo": "error",
     "campo": "sistem",
     "fuente": "meta"
    }
   ]
  },
  "estado": {
   "def": "A",
   "mayus": 1,
   "reglas": [
    {
     "si": "!(((estado == null || ['A','C','N','F','B','V','J'].includes(estado))))",
     "msg": "El estado debe ser Activo [A], Obra en curso [c], No amortiza [N], Fuera servicio [F], Baja [B] o Vendido [V].",
     "tipo": "error",
     "campo": "estado",
     "fuente": "meta"
    }
   ]
  },
  "sisamo": {
   "req": 1,
   "mayus": 1
  },
  "porcen": {
   "ro": "sisamo != 'L'",
   "calc": "sisamo == 'D'  && numeje !=0 ? Math.round(100 /numeje, 3): porcen"
  },
  "numeje": {
   "ro": "sisamo != 'D'",
   "calc": "sisamo == 'L' && porcen !=0 && porcen != null ? Math.round(100 /porcen + 0.499) : numeje"
  },
