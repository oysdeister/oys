 "alGuardar": [
  {
   "si": "!(((((taxl_valida == null) || (taxl_valida == 1)) && ((taxl_valori == null))) || (((taxl_valida == null) || (taxl_valida != 1)) && ((taxl_valori == null || [1,2,3,4,5,6,7].includes(taxl_valori))))))",
   "msg": "Si el impuesto no es validado, entonces requiere informar la causa de validación (1 Cashvat,2 Certificación obra privada,3 Certificación obra publica,4 Immuebles,5 Tracto sucesivo,6 Importación no despachada,7 Subproducto)",
   "tipo": "error",
   "fuente": "meta"
  },
  {
   "si": "!(((((taxl_porpro == null) || (taxl_porpro >= 0)) && ((taxl_porpro == null) || (100 >= taxl_porpro))) && (((taxl_porded == null) || (taxl_porded >= 0)) && ((taxl_porded == null) || (100 >= taxl_porded)))))",
   "msg": "El % prorrata y el % deductible debe estar entre 0 y 100.",
   "tipo": "error",
   "fuente": "meta"
  },
  {
   "si": "!((((taxl_nature == 'R') && ((taxl_porcen == null) || (taxl_porcen != 0))) || (taxl_nature != 'R')))",
   "msg": "Si la naturaleza es Arriendo [R], el % impuesto no debe ser 0, o la naturaleza no debe ser Arriendo [R].",
   "tipo": "error",
   "fuente": "meta"
  },
  {
   "si": "taxl_porded > 100 || taxl_porded < 0",
   "msg": "Check constraint (informix.c_ctax_move_line6) failed.",
   "tipo": "error",
   "fuente": "demo",
   "campo": "taxl_porded"
  }
 ],
 "notas": [
  "Ruta: Finanzas › (subrejilla)",
